<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EcoBuildss.Testler</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Testler uygulamanın hesap çekirdeğini doğrudan derler; arayüz koduna bağımlı değildir -->
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\Depo\*.cs" Link="Depo\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>
</Project>
